# Copy to .streamlit/secrets.toml. One line per account.
[auth.users]
investigator = "change-me"
supervisor = "change-me-too"

# Role per account: viewer (read only), investigator (default) or supervisor (also closes cases,
# removes watchlist entries, verifies the audit chain and evidence packs, resets thresholds)
[auth.roles]
investigator = "investigator"
supervisor = "supervisor"

# Optional: TronGrid API key for higher rate limits (https://www.trongrid.io)
[tron]
api_key = ""
